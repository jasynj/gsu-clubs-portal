generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String     @id @default(cuid())
  name         String     @unique
  type         OrgType
  slug         String     @unique
  logoUrl      String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  documents Document[]

  @@map("organizations")
}

model Document {
  id          String   @id @default(cuid())
  orgId       String
  docType     DocType
  title       String
  content     String   @db.Text
  fileUrl     String?
  version     Int      @default(1)
  updatedById String?  // slug of org or "admin"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("documents")
}

enum OrgType {
  nphc
  non_nphc
  club
}

enum DocType {
  constitution
  bylaws
}

model RegistrationRequest {
  id                 String   @id @default(cuid())
  orgName            String
  orgType            OrgType
  submittedCategory  String
  foundingMembers    Json
  meetingDates       Json
  fileUrls           Json
  status             RegStatus @default(pending)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("registration_requests")
}

enum RegStatus {
  pending
  approved
  rejected
}
